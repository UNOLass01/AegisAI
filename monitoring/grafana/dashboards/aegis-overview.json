{
  "title": "AegisAI Overview",
  "uid": "aegis-overview",
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (handler) (rate(http_requests_total[1m]))",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latency p50 / p95 by endpoint",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, handler) (rate(http_request_duration_seconds_bucket[2m])))",
          "legendFormat": "p50 {{handler}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket[2m])))",
          "legendFormat": "p95 {{handler}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error rate (5xx share)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[2m])) / sum(rate(http_requests_total[2m])) or vector(0)",
          "legendFormat": "5xx share",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Model version in use (predict req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (model_version) (rate(aegis_predict_requests_total[1m]))",
          "legendFormat": "{{model_version}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Precision proxy (true positives / flagged, by version)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (model_version) (rate(aegis_predict_true_positives_total[2m])) / sum by (model_version) (rate(aegis_predict_flagged_total[2m]))",
          "legendFormat": "{{model_version}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "/predict latency p95 by model version",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, model_version) (rate(aegis_predict_latency_seconds_bucket[2m])))",
          "legendFormat": "p95 {{model_version}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Agent step latency p95 by step",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, step) (rate(agent_step_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{step}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Agent tool latency breakdown (avg s by step)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (step) (rate(agent_step_duration_seconds_sum[5m])) / sum by (step) (rate(agent_step_duration_seconds_count[5m]))",
          "legendFormat": "avg {{step}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Agent token usage rate by direction",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (direction) (rate(agent_tokens_total[5m]))",
          "legendFormat": "{{direction}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Agent estimated cost (cumulative USD)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(agent_cost_usd_total)",
          "legendFormat": "USD",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
