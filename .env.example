# Copy to .env and fill in
# LLM provider for the investigation agent: auto (= openai when OPENAI_API_KEY
# is set, else deterministic stub), openai, ollama, or stub.
LLM_PROVIDER=auto
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1  # any OpenAI-compatible gateway
# OLLAMA_BASE_URL=http://localhost:11434/v1
DATABASE_URL=postgresql://aegis:aegis@postgres:5432/aegis

# Postgres (docker-compose)
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegis

# Frontend -> backend URL (baked at container start via environment)
VITE_API_URL=http://localhost:8000

# Grafana (docker-compose; anonymous viewer is enabled for the demo)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Backend observability
LOG_LEVEL=INFO

# RAG / knowledge base
QDRANT_URL=http://qdrant:6333
EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=openai  # alternative; requires OPENAI_API_KEY
# SKIP_RAG_AUTO_INGEST=1     # skip background knowledge ingestion at startup

# Investigation agent
PROMETHEUS_URL=http://prometheus:9090
